extends Node
## Autoload "Fx": sound effects, background music and screen transitions.
## All sounds in assets/audio are generated by tools/make_audio.py (original audio).

const DIR := "res://assets/audio/"
const SOUNDS := ["tap", "turn", "wrong", "hint", "clear", "award", "open"]
const MUSIC := "music_loop.ogg"
const PLAYER_COUNT := 6

var _streams: Dictionary = {}
var _players: Array = []
var _music: AudioStreamPlayer
var _fade: ColorRect
var _busy: bool = false


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for sound_name in SOUNDS:
		var stream: AudioStream = _load_audio(DIR + sound_name + ".wav")
		if stream != null:
			_streams[sound_name] = stream
	for i in PLAYER_COUNT:
		var p: AudioStreamPlayer = AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	_music = AudioStreamPlayer.new()
	_music.volume_db = -16.0
	_music.stream = _load_audio(DIR + MUSIC)
	_music.finished.connect(_on_music_finished)
	add_child(_music)
	var layer: CanvasLayer = CanvasLayer.new()
	layer.layer = 100
	add_child(layer)
	_fade = ColorRect.new()
	_fade.color = Color(0.0, 0.0, 0.0, 0.0)
	_fade.set_anchors_preset(Control.PRESET_FULL_RECT)
	_fade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(_fade)
	refresh_music()


## Imported resource in the exported game; raw file when the project was not imported (tests).
func _load_audio(path: String) -> AudioStream:
	if ResourceLoader.exists(path):
		return load(path) as AudioStream
	if FileAccess.file_exists(path):
		if path.ends_with(".ogg"):
			# Looked up by name so the script also loads on engine builds without the Ogg Vorbis module.
			if ClassDB.class_exists("AudioStreamOggVorbis"):
				return ClassDB.class_call_static("AudioStreamOggVorbis", "load_from_file", path) as AudioStream
			return null
		return AudioStreamWAV.load_from_file(path)
	return null


func _setting(key: String) -> bool:
	return bool((GameState.data["settings"] as Dictionary).get(key, true))


func loaded_sounds() -> int:
	return _streams.size()


func has_music() -> bool:
	return _music.stream != null


## Plays a short sound effect (ignored when sound is off or the file is missing).
func play(sound_name: String) -> void:
	if not _setting("sound") or not _streams.has(sound_name):
		return
	var player: AudioStreamPlayer = _players[0]
	for p in _players:
		if not (p as AudioStreamPlayer).playing:
			player = p
			break
	player.stream = _streams[sound_name]
	player.play()


func refresh_music() -> void:
	if _music.stream == null:
		return
	if _setting("music"):
		if not _music.playing:
			_music.play()
	else:
		_music.stop()


func _on_music_finished() -> void:
	if _setting("music"):
		_music.play()


## Changes scene with a short fade through black.
func go(path: String) -> void:
	_transition(path)


func reload() -> void:
	_transition("")


func _transition(path: String) -> void:
	if _busy:
		return
	_busy = true
	_fade.mouse_filter = Control.MOUSE_FILTER_STOP      # no taps while the screen changes
	var out: Tween = create_tween()
	out.tween_property(_fade, "color:a", 1.0, 0.14)
	await out.finished
	if path == "":
		get_tree().reload_current_scene()
	else:
		get_tree().change_scene_to_file(path)
	await get_tree().process_frame
	await get_tree().process_frame
	var back: Tween = create_tween()
	back.tween_property(_fade, "color:a", 0.0, 0.2)
	await back.finished
	_fade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_busy = false
