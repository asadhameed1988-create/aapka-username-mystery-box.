func t(key: String, args: Array = []) -> String:
	if not STRINGS.has(key):
		return key
	var entry: Dictionary = STRINGS[key]
	var text: String = str(entry.get(GameState.lang(), entry["en"]))
	if args.is_empty():
		return text
	return text % args
