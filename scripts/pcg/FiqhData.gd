## [topic index, school] for every topic/school pair that has an answer.
static func pairs() -> Array:
	var out: Array = []
	for t in TOPICS.size():
		var ans: Dictionary = TOPICS[t]["ans"]
		for school in SCHOOL_ORDER:
			if ans.has(school):
				out.append([t, school])
	return out
