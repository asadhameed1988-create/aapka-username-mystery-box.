# Copy to .env on the server and fill in. NEVER commit .env or paste these values into chat.
ENVIRONMENT=production
# 48+ random characters, e.g. from:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://mystery:${POSTGRES_PASSWORD}@db:5432/mystery_box
ADMIN_USER=owner
ADMIN_PASSWORD=
# Godot headless binary and the game project (both are set up by the Dockerfile)
GODOT_BIN=/opt/godot/godot
GAME_PROJECT_DIR=/srv/game
# 1 = the API process also runs the generation schedule every 30 minutes
BACKGROUND_WORKER=1
CORS_ORIGINS=
